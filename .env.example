# Copie para .env.local e preencha com suas chaves
# OpenRouter: https://openrouter.ai/keys (modelos :free disponíveis)
VITE_OPENROUTER_KEY=
# NVIDIA NIM: https://build.nvidia.com
VITE_NVIDIA_KEY=
# Modelos gratuitos (opcional — padrão: nemotron-3-super-120b-a12b)
VITE_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
VITE_NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
